(executable
  (public_name sqlgg)
  (modules :standard)
  (name cli)
  (promote (until-clean))
  (libraries
    extlib
    oUnit
    sqlgg
    unix
  )
  (preprocess (pps ppx_deriving.std))
)

(rule
 (alias runtest)
 (deps ./cli.exe)
 (action
   (run ./cli.exe -test)))

(rule
 (targets _cli-options.md)
 (deps ./cli.exe)
 (mode (promote (into ../doc)))
 (action
   (with-stdout-to %{targets} (run ./cli.exe -options-md))))

{
  "name": "sqlgg-lsp",
  "displayName": "sqlgg",
  "description": "Type checking, hover, completion and go-to-definition for SQL files handled by sqlgg",
  "version": "0.1.0",
  "publisher": "sqlgg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ygrek/sqlgg"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the server executable and its arguments are taken from user settings only.",
      "restrictedConfigurations": [
        "sqlgg.serverPath",
        "sqlgg.serverArgs"
      ]
    }
  },
  "contributes": {
    "configuration": {
      "title": "sqlgg",
      "properties": {
        "sqlgg.serverPath": {
          "type": "string",
          "default": "sqlgg-lsp",
          "description": "Path to the sqlgg-lsp executable."
        },
        "sqlgg.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to sqlgg-lsp."
        },
        "sqlgg.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log LSP traffic to the sqlgg output channel."
        }
      }
    },
    "commands": [
      {
        "command": "sqlgg.restartServer",
        "title": "sqlgg: Restart language server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0"
  }
}
